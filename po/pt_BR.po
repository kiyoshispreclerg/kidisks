#: src/main.c:46
#, c-format
msgid ""
"Usage: kidisks [OPTION]...\n"
"Disks, partitions, space usage and cleanup.\n"
"\n"
"  -t, --tab TAB        open on TAB: units, partitions, space or cleanup\n"
"  -c, --config FILE    settings file (default ~/.config/kidisks/kidisks."
"ini)\n"
"  -l, --list           list the disks and partitions and exit\n"
"  -b, --bytes          with --list: sizes and offsets in bytes\n"
"  -a, --all            with --list: also loop and zram devices\n"
"      --info DISK      drive details and health (SMART)\n"
"      --mount DEV      mount a filesystem (prints where)\n"
"      --unmount DEV    unmount it\n"
"      --eject DISK     eject the media\n"
"      --power-off DISK unmount everything on the drive and power it off\n"
"  -v, --verbose        print what is going on\n"
"  -V, --version        print the version and exit\n"
"  -h, --help           print this help and exit\n"
msgstr "Uso: kidisks [OPÇÃO]...\nDiscos, partições, uso do espaço e limpeza.\n\n  -t, --tab ABA        abre na ABA: units (unidades), partitions (partições),\n                       space (espaço) ou cleanup (limpeza), ou o número dela\n  -c, --config ARQ     arquivo de configuração (padrão ~/.config/kidisks/kidisks.ini)\n  -l, --list           lista os discos e partições e sai\n  -b, --bytes          com --list: tamanhos e posições em bytes\n  -a, --all            com --list: inclui loop e zram\n      --info DISCO     detalhes e saúde do disco (SMART)\n      --mount DISP     monta um sistema de arquivos (mostra onde)\n      --unmount DISP   desmonta\n      --eject DISCO    ejeta a mídia\n      --power-off DISCO desmonta tudo no disco e o desliga\n  -v, --verbose        mostra o que está acontecendo\n  -V, --version        mostra a versão e sai\n  -h, --help           mostra esta ajuda e sai\n"

