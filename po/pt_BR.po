#: src/main.c:44
#, c-format
msgid ""
"Usage: kidisks [OPTION]...\n"
"Disks, partitions, space usage and cleanup.\n"
"\n"
"  -t, --tab TAB        open on TAB: units, partitions, space or cleanup\n"
"  -c, --config FILE    settings file (default ~/.config/kidisks/kidisks."
"ini)\n"
"  -v, --verbose        print what is going on\n"
"  -V, --version        print the version and exit\n"
"  -h, --help           print this help and exit\n"
msgstr ""
"Uso: kidisks [OPÇÃO]...\n"
"Discos, partições, uso do espaço e limpeza.\n"
"\n"
"  -t, --tab ABA        abre na ABA: units (unidades), partitions "
"(partições),\n"
"                       space (espaço) ou cleanup (limpeza), ou o número "
"dela\n"
"  -c, --config ARQ     arquivo de configuração (padrão ~/.config/kidisks/"
"kidisks.ini)\n"
"  -v, --verbose        mostra o que está acontecendo\n"
"  -V, --version        mostra a versão e sai\n"
"  -h, --help           mostra esta ajuda e sai\n"

